            ecc: true,
            high_endurance: false,
            protect_when_active: false
          },
          {
            bank: 0,
            page: 8,
            pad: 0,
            read: true,
            program: true,
            erase: true,
            scramble: true,
            ecc: true,
            high_endurance: false,
            protect_when_active: false
